# Copy to .env.local for `vercel dev`. Add the same names in the hosting dashboard for production.
# Never commit real keys. Never paste them into a chat.

# Phase 0 — payments (Stripe → Developers → API keys). Use sk_test_ until the owner says go live.
STRIPE_SECRET_KEY=sk_test_xxx

# Phase 1 — orders + emails
STRIPE_WEBHOOK_SECRET=whsec_xxx          # from `stripe listen` locally, or the webhook endpoint page in production
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...         # server only. Never ship this to the browser.
RESEND_API_KEY=re_xxx
ORDER_EMAIL_TO=owner@example.com         # where new-order emails go
ORDER_EMAIL_FROM="Marble Box <orders@yourdomain.com>"   # must be a domain verified in Resend

# Phase 2 — admin page
ADMIN_PASSWORD=change-me-to-something-long
